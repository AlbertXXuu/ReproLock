{
  "name": "reprolock",
  "version": "0.0.0",
  "private": true,
  "description": "Local functional-regression evidence and standalone Playwright test tooling.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.2 <25",
    "pnpm": "11.19.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --project tsconfig.base.json --noEmit",
    "test:unit": "node --test \"tests/**/*.test.ts\"",
    "test:browser": "playwright test",
    "test": "pnpm test:unit && pnpm test:browser",
    "package:smoke": "node scripts/package-smoke.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "typescript": "7.0.2"
  }
}
