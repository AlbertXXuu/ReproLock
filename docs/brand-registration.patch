+def _validate_reprolock(tokens: dict[str, Any]) -> None:
+    """The subtitle-free consumer has the 330x100 master, not a legacy lockup."""
+    project = ROOT / "projects/ReproLock"
+    provenance = json.loads((project / "docs/assets/provenance.json").read_text(encoding="utf-8"))
+    if provenance.get("brandRevision") != tokens["brand_revision"] or provenance.get("interfaceRevision") != tokens["interface"]["revision"]:
+        raise SystemExit("ReproLock brand/interface revision drifted.")
+    expected_sources = {
+        "docs/assets/alvenx-wordmark.svg": "foundation/brand/assets/alvenx-wordmark.svg",
+        "docs/assets/alvenx-monogram.svg": "foundation/brand/assets/alvenx-monogram.svg",
+        "docs/assets/alvenx-ui.css": "foundation/brand/interface/alvenx-ui.css",
+        "docs/assets/InstrumentSans-wdth-wght.woff2": "projects/BrowserAgentRegression/src/browser_agent_regression/assets/fonts/InstrumentSans-wdth-wght.woff2",
+        "docs/assets/InstrumentSans-OFL.txt": "projects/BrowserAgentRegression/src/browser_agent_regression/assets/fonts/InstrumentSans-OFL.txt",
+    }
+    entries = provenance.get("assets", [])
+    if len(entries) != len(expected_sources) or {e.get("path"): e.get("source") for e in entries} != expected_sources:
+        raise SystemExit("ReproLock controlled resource inventory drifted.")
+    manifest = json.loads(RELEASE_MANIFEST_PATH.read_text(encoding="utf-8"))
+    consumers = {e["path"] for e in manifest["consumers"]}
+    for entry in entries:
+        relative = f'projects/ReproLock/{entry["path"]}'
+        data = (project / entry["path"]).read_bytes()
+        if data != (ROOT / entry["source"]).read_bytes() or _sha256(data) != entry["sha256"]:
+            raise SystemExit(f"ReproLock copy differs from its approved source: {relative}")
+        if relative not in tokens["assets"] or relative not in consumers:
+            raise SystemExit(f"ReproLock consumer is not registered: {relative}")
+    svg = ET.fromstring((project / "docs/assets/alvenx-wordmark.svg").read_bytes())
+    if svg.get("viewBox") != "0 0 330 100":
+        raise SystemExit("ReproLock must use the subtitle-free 330x100 wordmark.")
+    readmes = list(project.glob("README*.md"))
+    if not readmes:
+        raise SystemExit("ReproLock README is missing.")
+    for readme in readmes:
+        if not re.match(r'^<p align="center">\s*<img src="docs/assets/alvenx-wordmark\.svg" width="320" alt="AlvenX"\s*/?>\s*</p>\s*# ReproLock\b', readme.read_text(encoding="utf-8")):
+            raise SystemExit(f"ReproLock centered 320px README header drifted: {readme.name}")
+
+
